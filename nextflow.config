includeConfig 'conf/modules.config'

params {

    //container
    //Inspected v3.6.0 image: OpenMS 3.6.0-pre-HEAD-2026-09-30, revision 5d5cbff.
    //just keeping this as a baseline
    //openms_container = 'ghcr.io/openms/openms-tools-thirdparty@sha256:824bcdf017b96f3f4509f68395efe1ce19014be7cc2b07263ae3cb2e652dac02'
    //updated version
    openms_container = 'ghcr.io/openms/openms-tools-thirdparty@sha256:734197c186b23a98bdb5cb25071d28e10b125480f8d67d8aa59c76c3632c5ac0'

    //workflow ins, outs, resources
    input = null
    mzml_dir = null
    spectra_dir = null
    database = null
    outdir = 'results'
    cpus = 2

    //ThermoRawFileParser
    convert_raw = false

    //OpenMS Peakpicker: optional profile centroiding
    openms_peakpicking = false
    peakpicking_ms_levels = null

    //Comet: psm identification
    instrument = 'high_res'
    comet_max_variable_mods = 5
    //fragment bin tolerance override, always in Da.
    comet_fragment_mass_tolerance = null
    isotope_error_range = '0,3'

    //Comet + MS1labeledworflow:
    allowed_missed_cleavages = 2

    //psm validation / fdr filtering
    psm_fdr = 0.01

    //MS1labeledworflow
    //MS1labeledworflow: protein inference, fdr
    silac_picked_protein_fdr = true
    protein_level_fdr_cutoff = 0.01

    //MS1labeledworflow: fraction aggregation
    silac_fraction_aggregation = 'sum'

    //MS1labeledworflow: ratios, feature handling, ID-mappign
    silac_reference_channel = 1
    silac_min_ratio_count = 2
    silac_normalize_ratios = false
    silac_knock_out = true
    silac_requantify = true
    silac_id_mz_reference = 'peptide'
    silac_match_between_runs = false
    
    //allowed silac chemistry file
    silac_chemistry = "${projectDir}/assets/silac_chemistry.json"

    //optional qpx output
    enable_qpx = false
}

process {
    executor = 'local'
    cpus = 1

    withName: 'COMET|OPENMS_PEAK_PICKER|PEPTIDE_INDEXER|PERCOLATOR|MS1_LABELED_WORKFLOW' {
        cpus = params.cpus
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    low_memory {
        // Run one task at a time, including tasks from different processes.
        executor.queueSize = 1
    }

    test_duplex {
        // These fixtures contain profile spectra; retain the evaluated OpenMS route.
        params.openms_peakpicking = true
        params.input = "${projectDir}/testdata/PXD003327_duplex_002da.sdrf.tsv"
        params.mzml_dir = "${projectDir}/../openms_silac_bash/data/PXD003327/mzml"
        params.database = "${projectDir}/../openms_silac_bash/db/ecoli_k12_uniprot_reviewed.fasta"
    }

    test_triplex {
        params.openms_peakpicking = true
        params.input = "${projectDir}/testdata/PXD003327_triplex_002da.sdrf.tsv"
        params.mzml_dir = "${projectDir}/../openms_silac_bash/data/PXD003327/mzml"
        params.database = "${projectDir}/../openms_silac_bash/db/ecoli_k12_uniprot_reviewed.fasta"
    }
}
