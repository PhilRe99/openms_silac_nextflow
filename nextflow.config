includeConfig 'conf/modules.config'


manifest {
    name            = 'openms-silac-nextflow'
    author          = 'Philipp Rebs'
    version         = '0.1.0-dev'
    nextflowVersion = '>=25.10.0'
}

params {

    openms_container = 'ghcr.io/openms/openms-tools-thirdparty:v3.6.0'
    
    input      = null
    mzml_dir   = null
    database   = null
    outdir     = 'results'
    cpus = 2

    psm_fdr = 0.01
    allowed_missed_cleavages   = 2
    protein_level_fdr_cutoff   = 0.01
    silac_picked_protein_fdr   = true
    silac_fraction_aggregation = 'sum'
    silac_reference_channel   = 1
    silac_min_ratio_count     = 2
    silac_normalize_ratios    = false

    instrument                = 'high_res'
    isotope_error_range       = '0,3'
    silac_chemistry            = "${projectDir}/assets/silac_chemistry.json"

    enable_qpx = false
}

process {
    executor = 'local'
    cpus = 1

    withName: 'COMET|OPENMS_PEAK_PICKER|PEPTIDE_INDEXER|PERCOLATOR' {
        cpus = params.cpus
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    test_duplex {
        params.input    = "${projectDir}/testdata/PXD003327_duplex.sdrf.tsv"
        params.mzml_dir = "${projectDir}/../openms_silac_bash/data/PXD003327/mzml"
        params.database = "${projectDir}/../openms_silac_bash/db/ecoli_k12_uniprot_reviewed.fasta"
    }

    test_triplex {
        params.input    = "${projectDir}/testdata/PXD003327_triplex.sdrf.tsv"
        params.mzml_dir = "${projectDir}/../openms_silac_bash/data/PXD003327/mzml"
        params.database = "${projectDir}/../openms_silac_bash/db/ecoli_k12_uniprot_reviewed.fasta"
    }
}
