process {

    withName: 'SDRF_PARSING' {
        container = { params.sdrf_container }
        memory = '2 GB'

        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: 'copy',
            saveAs: { filename -> filename.tokenize('/').last() }
        ]
    }

    withName: 'RESOLVE_SILAC_CONFIG' {
        container = { params.python_container }
        
        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: 'copy',
            pattern: 'silac_config_*.json'
        ]
    }

    withName: 'SAVE_SILAC_CHEMISTRY' {
        container = { params.python_container }

        publishDir = [
        path: { "${params.outdir}/sdrf" },
        mode: 'copy',
        saveAs: { filename -> filename.tokenize('/').last() }
        ]
    }

    withName: 'COMET' {
        ext.args = {
            def bounds = params.isotope_error_range
                .split(',')
                .collect { it.toInteger() }

            def isotopeErrors = (bounds[0]..bounds[1]).join('/') 
            [
                    "-missed_cleavages ${params.allowed_missed_cleavages}",
                    "-max_variable_mods_in_peptide ${params.comet_max_variable_mods}",
                    "-instrument ${params.instrument}",
                    "-isotope_error ${isotopeErrors}"
            ].join(' ')
        }
    }

    withName: 'MS1_LABELED_WORKFLOW' {
        publishDir = [
            path: { "${params.outdir}/quant_tables" },
            mode: 'copy',
            pattern: 'experiment.{mzTab,consensusXML}'
        ]
        ext.args = { 
            [
                "-max_nr_labelled_aas ${params.allowed_missed_cleavages}",
                "-proteinFDR ${params.protein_level_fdr_cutoff}",
                "-picked_proteinFDR ${params.silac_picked_protein_fdr}",
                "-ProteinQuantification:fractions:aggregate ${params.silac_fraction_aggregation}",
                "-ratios:reference_channel ${params.silac_reference_channel}",
                "-ratios:min_ratio_count ${params.silac_min_ratio_count}",
                "-ratios:normalize ${params.silac_normalize_ratios}",
                "-algorithm:knock_out ${params.silac_knock_out}",
                "-requantify ${params.silac_requantify}",
                "-join_channels ${params.silac_join_channels}",
                "-targeted_quantification ${params.silac_targeted_quantification}",
                "-requantify_min_correlation ${params.silac_requantify_min_correlation}",
                "-requantify_correlation_ratio ${params.silac_requantify_correlation_ratio}",
                "-id_mapping:mz_reference ${params.silac_id_mz_reference}",
                "-match_between_runs ${params.silac_match_between_runs}",
                "-algorithm:rt_band ${params.silac_rt_band}",
                "-algorithm:averagine_similarity_scaling ${params.silac_averagine_similarity_scaling}",
                "-algorithm:intensity_cutoff ${params.silac_intensity_cutoff}",
                "-algorithm:mz_tolerance ${params.silac_detection_mz_tolerance}",
                "-id_mapping:rt_tolerance ${params.silac_id_rt_tolerance}",
                "-id_mapping:mz_tolerance ${params.silac_id_mz_tolerance}"
            ].join(' ')
        }
    }

    withName: 'QPX_ENRICH' {
        container = { params.qpx_container }

        publishDir = [
            path: { params.outdir },
            mode: 'copy',
            pattern: 'qpx'
        ]
    }

    withName: 'SUMMARY_PIPELINE' {
        container = { params.pmultiqc_container }
        cpus = 2
        memory = '4 GB'

        ext.args = '--quantms-plugin --ignored-idxml --config ./results/multiqc_config.yml --quantification-method feature_intensity'

        publishDir = [
            path: { "${params.outdir}/pmultiqc" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
